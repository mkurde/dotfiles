#!/usr/bin/env bash

# Daily tooling update system
# Runs once per day on first shell open to keep important CLI tools up-to-date

# Tool configuration - edit these arrays to add/remove tools
FAST_UPDATE_TOOLS=(bin kubent metafold skaffold)
SLOW_UPDATE_TOOLS=(brew gcloud)

# Casks to skip during `brew upgrade --cask` (they self-update and would fail
# the run if open, e.g. VS Code holding an app lock).
CASK_UPGRADE_EXCLUDE=(visual-studio-code cursor)

# System configuration
DAILY_UPDATE_LOCK_DIR="${HOME}/.cache/zsh-daily-updates"
DAILY_UPDATE_LOCK_FILE="${DAILY_UPDATE_LOCK_DIR}/last-update-date"

# Ensure cache directory exists
mkdir -p "${DAILY_UPDATE_LOCK_DIR}"

# Get current date (YYYY-MM-DD format)
current_date=$(date '+%Y-%m-%d')

# Check if we should run updates today
mk:daily-update:should_run() {
    # If lock file doesn't exist, we should run
    if [[ ! -f "${DAILY_UPDATE_LOCK_FILE}" ]]; then
        return 0
    fi

    # Read last update date
    local last_update_date
    last_update_date=$(cat "${DAILY_UPDATE_LOCK_FILE}" 2>/dev/null || echo "")

    # If dates differ, we should run
    if [[ "${current_date}" != "${last_update_date}" ]]; then
        return 0
    fi

    # Already updated today
    return 1
}

# Update lock file with current date
mk:daily-update:lock_file() {
    echo "${current_date}" > "${DAILY_UPDATE_LOCK_FILE}"
}

# Tool update functions
mk:daily-update:bin_tool() {
    local tool="${1}"
    if ! command -v gh &>/dev/null || ! command -v "${HOME}/bin/bin" &>/dev/null; then
        echo "Skipping ${tool} (gh or bin not available)"
        return 1
    fi

    local github_token
    github_token=$(gh auth token 2>/dev/null)
    if [[ -z "${github_token}" ]]; then
        echo "Skipping ${tool} (no GitHub token)"
        return 1
    fi

    echo "Updating ${tool}..."
    if GITHUB_AUTH_TOKEN="${github_token}" "${HOME}/bin/bin" update "${tool}" -y 2>/dev/null; then
        echo "${tool} updated"
        return 0
    else
        echo "${tool} up to date"
        return 1
    fi
}

mk:daily-update:simple_tool() {
    local tool="${1}"
    local cmd="${2}"

    if ! command -v "${tool}" &>/dev/null; then
        echo "Skipping ${tool} (not available)"
        return 1
    fi

    echo "Updating ${tool}..."
    if eval "${cmd}" 2>/dev/null; then
        echo "${tool} updated"
        return 0
    else
        echo "${tool} up to date"
        return 1
    fi
}

# Fast updates (tools that update quickly)
mk:daily-update:run_fast() {
    local has_updates=false

    echo "Daily tooling updates ($(date '+%H:%M:%S'))"
    echo "----------------------------------------"

    # Update bin-managed tools
    for tool in "${FAST_UPDATE_TOOLS[@]}"; do
        if mk:daily-update:bin_tool "${tool}"; then
            has_updates=true
        fi
    done

    # Summary
    echo "----------------------------------------"
    if [[ "${has_updates}" == "true" ]]; then
        echo "Updates completed at $(date '+%H:%M:%S')"
    else
        echo "All tools up to date"
    fi
    echo
}

# Slow updates (brew, gcloud, etc.) - runs in foreground
# Rotate the log once it gets large so it does not grow without bound
mk:daily-update:rotate_log() {
    local log_file="${1}"
    local max_bytes=1048576

    [[ -f "${log_file}" ]] || return 0

    local size
    size=$(wc -c < "${log_file}" | tr -d ' ')
    if (( size > max_bytes )); then
        mv -f "${log_file}" "${log_file}.1"
        echo "(previous log rotated to $(basename "${log_file}").1)" > "${log_file}"
    fi
}

# Run one update step: stream it, log it, and return the *command's* exit code.
# Without this the status of `cmd | tee` is tee's, which is always 0.
mk:daily-update:run_step() {
    local desc="${1}" log_file="${2}"
    shift 2

    local step_status
    echo "${desc}" | tee -a "${log_file}"
    # Translate CR to LF: progress redraws would otherwise glue themselves onto
    # the front of real messages and break the ^anchors in report_issues
    "${@}" 2>&1 | tr '\r' '\n' | tee -a "${log_file}"
    if [[ -n "${ZSH_VERSION}" ]]; then
        step_status=${pipestatus[1]}
    else
        step_status=${PIPESTATUS[0]}
    fi

    if (( step_status != 0 )); then
        # Logged in the format report_issues looks for, so a step that fails
        # silently still surfaces
        echo "Error: ${desc%%...} [${1}] exited with status ${step_status}" | tee -a "${log_file}"
    fi
    return ${step_status}
}

# Slow updates (brew, gcloud, etc.) - runs in foreground
mk:daily-update:run_slow() {
    local has_updates=false
    local failures=0
    local log_file="${DAILY_UPDATE_LOCK_DIR}/slow-updates.log"

    mk:daily-update:rotate_log "${log_file}"

    # Initialize log file
    echo "=== Slow updates started at $(date) ===" | tee -a "${log_file}"
    echo "Running slow updates (${SLOW_UPDATE_TOOLS[*]})..." | tee -a "${log_file}"
    echo "----------------------------------------" | tee -a "${log_file}"

    # Homebrew updates. Each step runs independently: a failing `brew update`
    # must not silently skip the upgrade and cleanup that follow it.
    if command -v brew &>/dev/null; then
        mk:daily-update:run_step "Updating Homebrew..." "${log_file}" \
            brew update || failures=$((failures + 1))
        mk:daily-update:run_step "Upgrading Homebrew formulae..." "${log_file}" \
            brew upgrade --formula || failures=$((failures + 1))
        # --force lets casks overwrite an app already present in the Caskroom
        # (e.g. installed/updated outside brew), which otherwise aborts the run.
        # Upgrade only outdated casks that aren't in CASK_UPGRADE_EXCLUDE.
        local -a outdated_casks upgrade_casks
        outdated_casks=(${(f)"$(brew outdated --cask --quiet 2>/dev/null)"})
        upgrade_casks=(${outdated_casks:|CASK_UPGRADE_EXCLUDE})
        if (( ${#upgrade_casks} )); then
            mk:daily-update:run_step "Upgrading Homebrew casks..." "${log_file}" \
                brew upgrade --cask --force "${upgrade_casks[@]}" || failures=$((failures + 1))
        else
            echo "No casks to upgrade (or all excluded)" | tee -a "${log_file}"
        fi
        mk:daily-update:run_step "Cleaning up Homebrew..." "${log_file}" \
            brew cleanup || failures=$((failures + 1))
        has_updates=true
    else
        echo "Skipping Homebrew (not available)" | tee -a "${log_file}"
    fi

    # Google Cloud SDK updates
    if command -v gcloud &>/dev/null; then
        mk:daily-update:run_step "Updating Google Cloud SDK..." "${log_file}" \
            gcloud components update --quiet || failures=$((failures + 1))
        has_updates=true
    else
        echo "Skipping Google Cloud SDK (not available)" | tee -a "${log_file}"
    fi

    echo "----------------------------------------" | tee -a "${log_file}"
    if [[ "${has_updates}" == "true" ]]; then
        echo "Slow updates finished at $(date) (${failures} failed step(s))" | tee -a "${log_file}"
    else
        echo "No slow tools available at $(date)" | tee -a "${log_file}"
    fi
    echo "" | tee -a "${log_file}"

    mk:daily-update:report_issues "${log_file}"
}

# Scan this run's log for errors and surface them loudly + via macOS notification
mk:daily-update:report_issues() {
    local log_file="${1}"
    # Match only the current run (after the last "Slow updates started" marker)
    local issues
    issues=$(awk '/=== Slow updates started/{buf=""} {buf=buf$0"\n"} END{printf "%s", buf}' "${log_file}" \
        | grep -E '^(Error|ERROR|Warning|WARNING):' \
        | grep -vE 'was renamed to|Hide these hints|Disable this behaviour|Treating .* as a formula|already installed' \
        || true)

    if [[ -z "${issues}" ]]; then
        return 0
    fi

    local count
    count=$(printf '%s\n' "${issues}" | wc -l | tr -d ' ')

    # Red ANSI for the banner, only if stdout is a tty
    local r='' n=''
    if [[ -t 1 ]]; then
        r=$'\e[1;31m'
        n=$'\e[0m'
    fi

    echo
    echo "${r}========================================${n}"
    echo "${r}  ${count} ISSUE(S) DURING DAILY UPDATE${n}"
    echo "${r}========================================${n}"
    printf '%s\n' "${issues}"
    echo "${r}========================================${n}"
    echo "Full log: daily-updates-log"
    echo

    if command -v osascript &>/dev/null; then
        osascript -e "display notification \"${count} issue(s) — run daily-updates-log\" with title \"Daily updates\" sound name \"Basso\"" &>/dev/null || true
    fi
}

# Main update function
mk:daily-update:run() {
    # Only run in normal interactive shells, not in agent mode or CI
    if [[ "${AGENT_MODE}" == "true" ]] || [[ -n "${CI}" ]] || [[ "${-}" != *i* ]]; then
        return 0
    fi

    # Check if we should run updates
    if ! mk:daily-update:should_run; then
        return 0
    fi

    # Create lock file immediately to prevent race conditions
    mk:daily-update:lock_file

    # Run fast updates
    mk:daily-update:run_fast

    # Run slow updates (brew, gcloud) in foreground
    mk:daily-update:run_slow

    # Show available commands
    echo "Available commands: daily-updates-force, daily-updates-status, daily-updates-log, daily-updates-stream"
}

# Helper function to show slow update logs
mk:daily-update:show_log() {
    local log_file="${DAILY_UPDATE_LOCK_DIR}/slow-updates.log"
    if [[ -f "${log_file}" ]]; then
        echo "Slow update log (last 50 lines):"
        echo "=================================="
        tail -n 50 "${log_file}"
    else
        echo "No slow update log found yet."
        echo "Last update: $(cat "${DAILY_UPDATE_LOCK_FILE}" 2>/dev/null || echo "never")"
    fi
}

# Helper function to force run updates (for testing)
mk:daily-update:force() {
    rm -f "${DAILY_UPDATE_LOCK_FILE}"
    mk:daily-update:run
}

# Helper function to stream log in real-time
mk:daily-update:stream_log() {
    local log_file="${DAILY_UPDATE_LOCK_DIR}/slow-updates.log"
    if [[ -f "${log_file}" ]]; then
        echo "Streaming slow update log (Ctrl+C to exit):"
        tail -f "${log_file}"
    else
        echo "No slow update log found to stream."
        echo "Run 'daily-updates-force' to create initial log file."
    fi
}

# Export helper functions for manual use
alias daily-updates-force='mk:daily-update:force'
alias daily-updates-log='mk:daily-update:show_log'
alias daily-updates-stream='mk:daily-update:stream_log'
alias daily-updates-status='echo "Last update: $(cat "${DAILY_UPDATE_LOCK_FILE}" 2>/dev/null || echo "never")"'

# Auto-run daily updates
mk:daily-update:run
